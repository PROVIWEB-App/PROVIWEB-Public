{
  "name": "proviweb-web",
  "version": "1.0.0",
  "description": "PROVIWEB - Red social para artistas y músicos",
  "scripts": {
    "serve": "firebase emulators:start --only hosting",
    "serve:all": "firebase emulators:start",
    "dev": "vite",
    "start": "npm run serve",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:all": "firebase deploy --only hosting,database && cross-env FIREBASE_SKIP_EXTENSIONS=true firebase deploy --only functions"
  },
  "private": true,
  "devDependencies": {
    "@vitejs/plugin-react": "^3.1.0",
    "http-server": "^14.1.1",
    "vite": "^4.5.14"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@react-three/drei": "9.105.6",
    "@react-three/fiber": "8.15.19",
    "autoprefixer": "^10.4.24",
    "gsap": "^3.12.3",
    "postcss": "^8.5.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-reconciler": "0.27.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.159.0"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
